# windots — included from ~/.gitconfig, never overwrites it.
# Identity ([user]) deliberately lives in ~/.gitconfig, not here.

[core]
	pager = delta
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true
	side-by-side = true
	line-numbers = true
	syntax-theme = Catppuccin Mocha
	hyperlinks = true
[merge]
	conflictstyle = zdiff3
[diff]
	colorMoved = default
[init]
	defaultBranch = main
[pull]
	rebase = true
[fetch]
	prune = true
[rebase]
	autoStash = true
[column]
	ui = auto
[branch]
	sort = -committerdate
